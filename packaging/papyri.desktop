[Desktop Entry]
Name=Papyri
GenericName=Document Viewer
Comment=Read Markdown, PDF, Typst, and LaTeX documents
Exec=papyri %f
TryExec=papyri
Icon=papyri
Terminal=false
Type=Application
Categories=Office;Viewer;
MimeType=text/markdown;text/x-markdown;application/pdf;text/vnd.typst;text/x-tex;
Keywords=Markdown;PDF;Typst;LaTeX;Preview;Reader;Math;Diagrams;
StartupWMClass=papyri
