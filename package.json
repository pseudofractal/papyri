{
  "name": "papyri",
  "version": "0.1.0",
  "description": "A read-only Markdown, PDF, Typst, and LaTeX viewer with offline math and diagrams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pseudofractal/papyri.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-renderer.mjs && vite --host 127.0.0.1",
    "build": "node scripts/build-renderer.mjs && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "icons": "node scripts/build-icons.mjs",
    "tauri": "tauri",
    "bench": "node scripts/benchmark.mjs",
    "bench:startup": "node scripts/benchmark-startup.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "1.63.0",
    "@tauri-apps/api": "2.12.4",
    "@viz-js/viz": "3.31.0",
    "dompurify": "3.4.17",
    "github-slugger": "2.0.0",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.2.0",
    "pdfjs-dist": "6.4.299",
    "svelte": "5.57.3",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "26.6.5",
    "daisyui": "5.7.50",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
