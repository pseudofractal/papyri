{
  "identifier": "main",
  "description": "Host UI only; document frames have opaque origins and no IPC permissions.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-initial-path",
    "allow-startup-trace",
    "allow-list-directory",
    "allow-read-document",
    "allow-read-pdf",
    "allow-read-asset",
    "allow-document-stamp",
    "allow-pick-path",
    "allow-open-external",
    "allow-browser-show",
    "allow-browser-select",
    "allow-browser-quote",
    "allow-browser-search-wikipedia",
    "allow-browser-open-window",
    "allow-browser-set-zoom",
    "allow-browser-navigate",
    "allow-browser-back",
    "allow-browser-forward",
    "allow-browser-reload",
    "allow-browser-stop",
    "allow-browser-set-visible",
    "allow-browser-set-bounds",
    "allow-control-ready",
    "allow-control-respond",
    "allow-control-emit"
  ]
}
